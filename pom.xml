<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-internal-spring-boot-parent</artifactId>
        <version>9.4.2</version>
    </parent>

    <artifactId>jeap-spring-modulith-error-handling-starter-parent</artifactId>
    <version>1.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>jEAP Spring Boot starter for handling failed Spring Modulith event publications.</description>
    <url>https://github.com/jeap-admin-ch/jeap-spring-modulith-error-handling-starter/tree/main</url>

    <scm>
        <url>https://github.com/jeap-admin-ch/jeap-spring-modulith-error-handling-starter.git</url>
        <connection>scm:git:git://github.com/jeap-admin-ch/jeap-spring-modulith-error-handling-starter.git</connection>
        <developerConnection>scm:git:ssh://github.com:jeap-admin-ch/jeap-spring-modulith-error-handling-starter.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <name>BIT</name>
            <email>jeap-community@bit.admin.ch</email>
            <organization>Federal Office of Information Technology, Systems and Telecommunication FOITT</organization>
            <organizationUrl>https://www.bit.admin.ch/</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>jeap-spring-modulith-error-handling-starter</module>
        <module>jeap-spring-modulith-error-handling-starter-it</module>
    </modules>

    <properties>
        <jeap-messaging.version>18.10.1</jeap-messaging.version>
        <jeap-messaging-outbox.version>17.19.0</jeap-messaging-outbox.version>
        <modulith-publication-failure-event.version>1.0.0</modulith-publication-failure-event.version>
        <modulith-publication-command.version>1.1.0</modulith-publication-command.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <maven.javadoc.skip>false</maven.javadoc.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-messaging</artifactId>
                <version>${jeap-messaging.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-messaging-outbox</artifactId>
                <version>${jeap-messaging-outbox.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap.messagetype.jeap</groupId>
                <artifactId>modulith-publication-processing-failed-event</artifactId>
                <version>${modulith-publication-failure-event.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap.messagetype.jeap</groupId>
                <artifactId>retry-modulith-publication-command</artifactId>
                <version>${modulith-publication-command.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap.messagetype.jeap</groupId>
                <artifactId>discard-modulith-publication-command</artifactId>
                <version>${modulith-publication-command.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Bundle-License>https://www.apache.org/licenses/LICENSE-2.0</Bundle-License>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.honton.chas</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
